# 复制为本目录的 .env 。DASHSCOPE_API_KEY 若这里留空，会再读上一级目录的 .env。

# 本地 Qwen3.5-2B。权重在 My Passport/qwen35-2b。打开 Mac 应用时，若 8080 没在听，会运行 start_qwen.sh。
QWEN_API_BASE=http://127.0.0.1:8080/v1
# QWEN_START=/Volumes/My Passport/qwen35-2b/start_qwen.sh
QWEN_MODEL=qwen3.5-2b
QWEN_API_KEY=local

# 阿里云百炼 Z-Image-Turbo，华北 2（北京）
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 业务空间域名可换成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1

# 不授权定位时使用的天气坐标，默认上海
DAYPLACE_LAT=31.2304
DAYPLACE_LON=121.4737
DAYPLACE_CITY=上海

DAYPLACE_HOST=127.0.0.1
DAYPLACE_PORT=8770

# 设为 0 时不改系统桌面。默认会把当前时辰的图铺到桌面。
# DAYPLACE_WALLPAPER=0
